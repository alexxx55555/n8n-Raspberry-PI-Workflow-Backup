      "id": "7fe3bbfe-6b9e-4175-82b1-7a5a99b456d4",
      "name": "Check Market (SPY)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -624,
        48
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "market-open-today",
              "leftValue": "={{ new Date($json.chart.result[0].meta.regularMarketTime * 1000).toLocaleDateString('en-CA', { timeZone: 'America/New_York' }) === new Date().toLocaleDateString('en-CA', { timeZone: 'America/New_York' }) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "62f222f8-fe0f-4b1c-87e8-2f0527467b0a",
      "name": "Market Open Today?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -432,
        48
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "stock",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a5ddf66c-2ae1-4b65-b50f-1d8fab06a95e",
      "name": "Slack Command",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -864,
        224
      ],
      "webhookId": "a1f0c1de-1111-4a11-9a11-000000000002"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "📈 Fetching quotes...",
        "options": {}
      },
      "id": "5292a283-f98b-4a85-a75b-9191cfc20221",
      "name": "Quick Reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -512,
        224
      ]
    },
    {
      "parameters": {
        "jsCode": "let symbols = ['AAPL', 'VOO', 'NVDA']; // default list\n\ntry {\n  const text = $('Slack Command').first().json.body.text || '';\n  const custom = text\n    .toUpperCase()\n    .split(/[\\s,]+/)\n    .filter(s => /^[A-Z0-9.\\-^=]{1,12}$/.test(s));\n  if (custom.length) symbols = custom;\n} catch (e) {\n  // triggered by schedule/manual, so use defaults\n}\n\nreturn symbols.map(symbol => ({ json: { symbol } }));"
      },
      "id": "775937b7-60a9-45a4-b851-f226414b1e32",
      "name": "Stock Symbols",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -112,
        -96
      ]
    },
    {
      "parameters": {
        "url": "={{ 'https://query1.finance.yahoo.com/v8/finance/chart/' + $json.symbol + '?interval=1d&range=1d' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0"
            }
          ]
        },
        "options": {}
      },
      "id": "e6c78b1a-47a9-463a-8800-e2d642d7754f",
      "name": "Get Quote (Yahoo Finance)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        112,
        -96
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const result = item.json?.chart?.result?.[0];\n  if (!result) {\n    return { json: { error: 'No data returned', raw: item.json } };\n  }\n  const m = result.meta;\n  const price = m.regularMarketPrice;\n  const prev = m.chartPreviousClose;\n  const change = price - prev;\n  const pct = prev ? (change / prev) * 100 : null;\n  const arrow = change >= 0 ? '🟢' : '🔴';\n  return {\n    json: {\n      symbol: m.symbol,\n      price: Number(price.toFixed(2)),\n      previousClose: Number(prev.toFixed(2)),\n      change: Number(change.toFixed(2)),\n      changePercent: pct !== null ? Number(pct.toFixed(2)) : null,\n      currency: m.currency,\n      exchange: m.fullExchangeName,\n      summary: `${arrow} ${m.symbol}: ${price.toFixed(2)} ${m.currency} (${change >= 0 ? '+' : ''}${pct.toFixed(2)}%)`\n    }\n  };\n});"
      },
      "id": "0fe4982f-a61c-418d-a5a6-45c2ee00df4c",
      "name": "Format Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        -96
      ]
    },
    {
      "parameters": {
        "jsCode": "const lines = $input.all().map(i => i.json.summary || i.json.error);\nreturn [{ json: { message: 'Stock update:\\n' + lines.join('\\n') } }];"
      },
      "id": "2546c16d-6b95-49ee-815f-90b7dbcc29d6",
      "name": "Combine Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        -96
      ]
    },
    {
