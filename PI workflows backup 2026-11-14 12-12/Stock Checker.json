  "nodes": [
    {
      "parameters": {},
      "id": "d0704360-7640-4701-b2c2-ba4d6adae2be",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -640,
        -96
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "5 8 * * *"
            }
          ]
        }
      },
      "id": "c9fefd5e-98f3-4d57-a3c6-fbdc610d2015",
      "name": "Daily 17:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -640,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const symbols = ['AAPL', 'VOO', 'NVDA'];\nreturn symbols.map(symbol => ({ json: { symbol } }));"
      },
      "id": "2b5c1ad2-9b58-46b7-9735-92c913c01a35",
      "name": "Stock Symbols",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -384,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ 'https://query1.finance.yahoo.com/v8/finance/chart/' + $json.symbol + '?interval=1d&range=1d' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0"
            }
          ]
        },
        "options": {}
      },
      "id": "7fe6861b-5764-45ca-afa1-6295ae35c2cc",
      "name": "Get Quote (Yahoo Finance)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -112,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const result = item.json?.chart?.result?.[0];\n  if (!result) {\n    return { json: { error: 'No data returned', raw: item.json } };\n  }\n  const m = result.meta;\n  const price = m.regularMarketPrice;\n  const prev = m.chartPreviousClose;\n  const change = price - prev;\n  const pct = prev ? (change / prev) * 100 : null;\n  const arrow = change >= 0 ? '🟢' : '🔴';\n  return {\n    json: {\n      symbol: m.symbol,\n      price: Number(price.toFixed(2)),\n      previousClose: Number(prev.toFixed(2)),\n      change: Number(change.toFixed(2)),\n      changePercent: pct !== null ? Number(pct.toFixed(2)) : null,\n      currency: m.currency,\n      exchange: m.fullExchangeName,\n      summary: `${arrow} ${m.symbol}: ${price.toFixed(2)} ${m.currency} (${change >= 0 ? '+' : ''}${pct.toFixed(2)}%)`\n    }\n  };\n});"
      },
      "id": "686d24c9-4221-423c-b403-b08ea22e1753",
      "name": "Format Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        144,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const lines = $input.all().map(i => i.json.summary || i.json.error);\nreturn [{ json: { message: 'Stock update:\\n' + lines.join('\\n') } }];"
      },
      "id": "4b988524-f894-421b-b438-d8d66148220c",
      "name": "Combine Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "select": "user",
        "user": {
          "__rl": true,
          "value": "U08AYDL2FQD",
          "mode": "id"
        },
        "text": "={{ $json.message }}",
        "otherOptions": {}
      },
      "id": "c6d03f98-7cc4-4734-afda-36f33a0d8762",
      "name": "Send Slack DM",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
