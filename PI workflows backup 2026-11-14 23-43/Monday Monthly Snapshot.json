        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Monday answers HTTP 200 even when it fails, so look inside each response\nreturn $input.all().map(item => {\n  const r = item.json;\n  const g = r.data && r.data.duplicate_group;\n  if (g && g.id) return { json: { ok: true, id: g.id, title: g.title } };\n  const detail = r.error_message || (r.errors ? JSON.stringify(r.errors) : (r.error ? JSON.stringify(r.error) : JSON.stringify(r)));\n  return { json: { ok: false, detail: String(detail).slice(0, 500) } };\n});"
      },
