      "id": "1403bfd6-a292-480c-a62a-66621ccdcd21",
      "name": "Month-end 23:00 Israel",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -912,
        80
      ],
      "notes": "Fires at 23:00 on days 28-31; the next node only continues on the last day of the month."
    },
    {
      "parameters": {
        "jsCode": "// ---------------- SETTINGS (edit here) ----------------\nconst BOARD_ID = '5107850029';\nconst GROUP_TITLES = ['To Do', 'In Progress'];   // exact titles of the groups to back up every month\nconst FORCE_RUN = false;        // TEST ONLY: true = run on any day (group names get a TEST prefix)\n// ------------------------------------------------------\n\n// Runs on days 28-31 at 23:00; only continues on the LAST day of the month (Israel time)\nconst tz = 'Asia/Jerusalem';\nconst t = Object.fromEntries(\n  new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' })\n    .formatToParts(new Date()).map(p => [p.type, p.value])\n);\n\n// day before the 1st of next month = last day of this month\nconst lastDay = new Date(Date.UTC(Number(t.year), Number(t.month), 1) - 86400000).getUTCDate();\nif (!FORCE_RUN && Number(t.day) !== lastDay) return [];\n\nreturn [{ json: {\n  boardId: BOARD_ID,\n  groupTitles: GROUP_TITLES,\n  namePrefix: (FORCE_RUN ? 'TEST ' : '') + `Snapshot ${t.year}-${t.month}`\n} }];"
      },
      "id": "9951f148-44c6-4e65-ba00-4c5bd54f0138",
      "name": "Build Snapshot Name",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -672,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "API-Version",
              "value": "2024-10"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: `{ boards(ids: [${$json.boardId}]) { id name groups { id title } } }` }) }}",
        "options": {}
      },
      "id": "6af81269-c912-4af0-b713-735e09168e6f",
      "name": "Get Groups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -416,
        80
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "DEEjaXy7pOncZeQ1",
          "name": "Monday.com"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Build Snapshot Name').first().json;\nconst r = $input.first().json;\n\nconst fail = (detail) => [{ json: { proceed: false, ok: false, detail: String(detail).slice(0, 500) } }];\n\nif (r.errors || r.error_message || r.error || !r.data) {\n  return fail(r.error_message || (r.errors ? JSON.stringify(r.errors) : JSON.stringify(r.error || r)));\n}\nconst board = (r.data.boards || [])[0];\nif (!board) return fail('Board ' + cfg.boardId + ' was not found, or this token cannot see it.');\n\n// One item per group to back up; groups that are not found become a failure item\nconst out = [];\nconst missing = [];\nfor (const title of cfg.groupTitles) {\n  const wanted = String(title).trim().toLowerCase();\n  const g = (board.groups || []).find(x => String(x.title).trim().toLowerCase() === wanted);\n  if (!g) { missing.push(title); continue; }\n  out.push({ json: { proceed: true, boardId: cfg.boardId, groupId: g.id, groupName: cfg.namePrefix + ' - ' + g.title, sourceTitle: g.title } });\n}\nif (missing.length) {\n  out.push({ json: { proceed: false, ok: false,\n    detail: 'Group(s) not found on board \"' + board.name + '\": ' + missing.join(', ') +\n            '. Groups there: ' + (board.groups || []).map(x => x.title).join(', ') } });\n}\nreturn out;"
      },
